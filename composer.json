{
	"name": "phpbbmodders/titaniareleaseimport",
	"type": "phpbb-extension",
	"description": "Lets contribution authors add a new Titania revision straight from a GitHub release.",
	"homepage": "https://www.phpbbmodders.com/",
	"version": "1.0.0-dev",
	"keywords": [
		"phpbb",
		"extension",
		"titania",
		"github",
		"releases"
	],
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "phpBB Modders",
			"email": "board@phpbbmodders.com",
			"homepage": "https://www.phpbbmodders.com/",
			"role": "Extension Developer"
		}
	],
	"require": {
		"php": ">=8.2.0",
		"composer/installers": "^1.0 || ^2.0"
	},
	"extra": {
		"display-name": "Titania Release Import",
		"soft-require": {
			"phpbb/phpbb": ">=4.0.0-a1,<4.1.0@dev"
		}
	}
}
